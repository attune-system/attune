#!/bin/sh
set -eu

case "$(uname -m)" in
    x86_64|amd64)
        target=linux-amd64
        ;;
    aarch64|arm64)
        target=linux-arm64
        ;;
    *)
        echo "Unsupported timer sensor architecture: $(uname -m)" >&2
        exit 1
        ;;
esac

sensor_dir="$(dirname "$0")"
packaged_binary="${sensor_dir}/bin/${target}/attune-core-timer-sensor"
if [ -x "$packaged_binary" ]; then
    exec "$packaged_binary" "$@"
fi

exec "${sensor_dir}/attune-core-timer-sensor" "$@"
