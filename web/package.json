{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "typecheck:contracts": "tsc -p tsconfig.contracts.json --pretty false",
    "lint": "eslint .",
    "knip": "npx --yes knip --config knip.json --production",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:api-generation": "node --test scripts/openapi-client-schema.test.mjs scripts/openapi-client-schema-unions.test.mjs",
    "generate:api": "node ./scripts/generate-api.mjs",
    "generate:api-client": "node ./scripts/generate-api.mjs --input ./openapi.json",
    "check:api": "node ./scripts/generate-api.mjs --check",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@tanstack/react-query": "^5.107.1",
    "axios": "^1.21.1",
    "d3": "^7.9.2",
    "date-fns": "^4.1.0",
    "js-yaml": "^5.5.0",
    "lucide-react": "^0.562.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/d3": "^7.4.3",
    "@types/node": "^24.10.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.6.2",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^16.5.0",
    "jsdom": "^29.1.1",
    "openapi-typescript-codegen": "^0.31.0",
    "postcss": "^8.5.33",
    "prettier": "^3.10.1",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
