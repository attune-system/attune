# Dockerfile for running Rust integration tests against a live database
#
# Compiles the workspace in test mode and runs the normal test set.
# Database tests exercise repositories, API endpoints, and execution logic
# directly in Rust. Explicitly ignored external and load tests remain opt-in.
#
# The image keeps the source tree layout intact so CARGO_MANIFEST_DIR-relative
# path lookups (../../config.test.yaml, ../../migrations) work correctly.
#
# Usage:
#   docker compose -f docker-compose.yaml -f docker-compose.e2e.yaml \
#     run --rm rust-int-tests [filter]

ARG RUST_VERSION=1.98.1
ARG DEBIAN_VERSION=bookworm

FROM rust:${RUST_VERSION}-${DEBIAN_VERSION} AS builder

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    ca-certificates \
    python3 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# Increase rustc stack size to prevent SIGSEGV
ENV RUST_MIN_STACK=67108864

# Copy dependency metadata first for layer caching
COPY Cargo.toml Cargo.lock ./
COPY crates/common/Cargo.toml ./crates/common/Cargo.toml
COPY crates/api/Cargo.toml ./crates/api/Cargo.toml
COPY crates/executor/Cargo.toml ./crates/executor/Cargo.toml
COPY crates/sensor/Cargo.toml ./crates/sensor/Cargo.toml
COPY crates/worker/Cargo.toml ./crates/worker/Cargo.toml
COPY crates/notifier/Cargo.toml ./crates/notifier/Cargo.toml
COPY crates/supervisor/Cargo.toml ./crates/supervisor/Cargo.toml
COPY crates/cli/Cargo.toml ./crates/cli/Cargo.toml

# Create minimal stub sources for dep resolution and fetch
RUN mkdir -p crates/common/src && echo "" > crates/common/src/lib.rs && \
    mkdir -p crates/api/src && echo "fn main(){}" > crates/api/src/main.rs && \
    mkdir -p crates/executor/src && echo "fn main(){}" > crates/executor/src/main.rs && \
    mkdir -p crates/executor/benches && echo "fn main(){}" > crates/executor/benches/context_clone.rs && \
    mkdir -p crates/sensor/src && echo "fn main(){}" > crates/sensor/src/main.rs && \
    mkdir -p crates/worker/src && echo "fn main(){}" > crates/worker/src/main.rs && \
    echo "fn main(){}" > crates/worker/src/agent_main.rs && \
    mkdir -p crates/notifier/src && echo "fn main(){}" > crates/notifier/src/main.rs && \
    mkdir -p crates/supervisor/src && echo "fn main(){}" > crates/supervisor/src/main.rs && \
    mkdir -p crates/cli/src && echo "fn main(){}" > crates/cli/src/main.rs

# Download dependencies (cached unless Cargo.toml/Cargo.lock change)
RUN --mount=type=cache,target=/usr/local/cargo/registry,id=attune-cargo-registry-v2,sharing=locked \
    --mount=type=cache,target=/usr/local/cargo/git,id=attune-cargo-git-v2,sharing=locked \
    cargo fetch

# Copy source and the files embedded or read while compiling tests. Keep the
# rest of docker/ and packaging/ after compilation so harness-only changes do
# not invalidate the expensive workspace test build.
COPY crates/ ./crates/
COPY migrations/ ./migrations/
COPY docker/extract-rust-test-artifacts.py ./docker/extract-rust-test-artifacts.py
COPY docker/run-migrations.sh ./docker/run-migrations.sh
COPY docker/Dockerfile.migrations-package ./docker/Dockerfile.migrations-package
COPY docker/distributable/docker-compose.yaml ./docker/distributable/docker-compose.yaml
COPY packaging/scripts/postinstall.sh ./packaging/scripts/postinstall.sh
COPY docker-compose.yaml ./docker-compose.yaml
COPY config.test.yaml ./config.test.yaml

ARG ATTUNE_FORCE_COMPILE_FAILURE=0

# Compile in a reusable BuildKit target cache, then copy test
# executables into the image. This avoids exporting Cargo's multi-gigabyte
# incremental directory while still ensuring runtime invocations never rebuild.
# The cargo command writes directly to a file (no masking pipeline), so any
# compilation failure fails the image build.
RUN --mount=type=cache,target=/usr/local/cargo/registry,id=attune-cargo-registry-v2,sharing=locked \
    --mount=type=cache,target=/usr/local/cargo/git,id=attune-cargo-git-v2,sharing=locked \
    --mount=type=cache,target=/build/target,id=rust-integration-tests,sharing=locked \
    if [ "$ATTUNE_FORCE_COMPILE_FAILURE" = "1" ]; then \
      printf '\nthis_is_an_intentional_compile_error!();\n' >> crates/common/src/lib.rs; \
    fi && \
    cargo metadata --format-version=1 --no-deps > /tmp/cargo-metadata.json && \
    cargo test --workspace --all-features --no-run --message-format=json-render-diagnostics > /tmp/cargo-artifacts.jsonl && \
    python3 docker/extract-rust-test-artifacts.py \
      /tmp/cargo-metadata.json /tmp/cargo-artifacts.jsonl /build/test-artifacts

# These files are runtime fixtures, but changes to them do not require a Rust
# rebuild unless they were copied explicitly above.
COPY docker/ ./docker/
COPY packaging/ ./packaging/

FROM debian:${DEBIAN_VERSION}-slim AS runtime

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    libssl3 \
    python3 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build
ENV RUST_MIN_STACK=67108864

COPY --from=builder /build/test-artifacts ./test-artifacts
COPY --from=builder /build/crates ./crates
COPY --from=builder /build/migrations ./migrations
COPY --from=builder /build/docker ./docker
COPY --from=builder /build/packaging ./packaging
COPY --from=builder /build/docker-compose.yaml ./docker-compose.yaml
COPY --from=builder /build/config.test.yaml ./config.test.yaml

COPY docker/rust-tests-entrypoint.sh /app/entrypoint.sh
COPY scripts/check-db-test-threads.sh /app/check-db-test-threads.sh
RUN chmod +x /app/entrypoint.sh /app/check-db-test-threads.sh

ENTRYPOINT ["/app/entrypoint.sh"]
