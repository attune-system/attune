FROM debian:bookworm-slim AS certificates
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/*

FROM busybox:1.36

COPY --from=certificates /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt

COPY dist/attune-agent /usr/local/bin/attune-agent
COPY dist/attune-sensor-agent /usr/local/bin/attune-sensor-agent
COPY dist/attune-mcp /usr/local/bin/attune-mcp
COPY dist/attune /usr/local/bin/attune
COPY dist/attune-workload-runner /usr/local/bin/attune-workload-runner

ENTRYPOINT ["/usr/local/bin/attune-agent"]
